# Copy this file to .env for local Docker Compose development.

APP_ENV=development

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Common
JOB_QUEUE_ADDRESS=redis:6379
JWT_SECRET=replace-with-a-long-random-secret-for-local-development
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Postgres Configuration
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=videogen
DATABASE_URL=postgres://user:password@postgres:5432/videogen

# MinIO/S3 Configuration
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=videos
S3_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Shared Directory for Renderer/Distributor
WORK_DIR=/app/workdir

# Distribution
DRY_RUN_YOUTUBE=true
DRY_RUN_TIKTOK=false

# OAuth connections
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=change-me-tiktok_client_secret
TIKTOK_REDIRECT_URI=http://localhost:8080/api/v1/oauth/tiktok/callback

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=change-me-youtube_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:8080/api/v1/oauth/youtube/callback
LOG_DIR=/var/log/app
RATE_LIMIT_PER_SECOND=2
GIN_MODE=debug
